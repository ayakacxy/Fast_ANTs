{
  "config": {
    "default": true,
    "MD013": false,
    "MD033": {
      "allowed_elements": [
        "div",
        "h1"
      ]
    }
  },
  "globs": [
    "**/*.md",
    ".github/*.md"
  ],
  "ignores": [
    ".cleanup-records/**",
    ".git/**",
    ".venv/**",
    "node_modules/**",
    "build/**",
    "dist/**",
    "reference/**",
    "setup/**"
  ]
}
